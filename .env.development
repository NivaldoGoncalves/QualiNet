#POSTGRES_DB=local_db
#POSTGRES_PASSWORD=local_password 
#DATABASE_URL=postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB

ORACLE_HOST=localhost            # Endereço do servidor Oracle (pode ser um IP ou nome de host)
ORACLE_PORT=1521                 # Porta padrão para Oracle (geralmente é 1521)
ORACLE_USER=oracle_user          # Usuário de autenticação no banco de dados Oracle
ORACLE_PASSWORD=oracle_password  # Senha do usuário Oracle
ORACLE_DB=oracle_db              # Nome do serviço ou SID do banco de dados Oracle
DATABASE_URL=oracle://$ORACLE_USER:$ORACLE_PASSWORD@$ORACLE_HOST:$ORACLE_PORT/$ORACLE_DB
